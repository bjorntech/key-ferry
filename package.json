{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@bjorntech/key-ferry",
  "version": "0.1.11",
  "description": "Project-scoped Key Ferry integration for OpenCode V2",
  "keywords": [],
  "homepage": "https://github.com/bjorntech/key-ferry#readme",
  "bugs": {
    "url": "https://github.com/bjorntech/key-ferry/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjorntech/key-ferry.git"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs",
    "examples"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./options": {
      "types": "./dist/options.d.ts",
      "import": "./dist/options.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./relay": {
      "types": "./dist/relay/index.d.ts",
      "import": "./dist/relay/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage && bun scripts/check-coverage.ts",
    "test:crap": "bun scripts/crap/run.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "quality": "npm run format:check && npm run typecheck && npm run test:coverage && npm run test:crap",
    "prepack": "npm run build",
    "prepublishOnly": "npm run quality && npm run build"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.30",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/node": "^24.0.0",
    "effect": "4.0.1",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "oxfmt": "0.72.0",
    "solid-js": "1.9.17",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.30",
    "effect": "4.0.1",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
