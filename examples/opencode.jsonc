{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      // Merge this entry into your existing config; preserve unrelated
      // plugins and MCP servers.
      "package": "@bjorntech/key-ferry@0.1.1",
      "options": {
        "enabled": true,
        "projectDirectory": ".",
        "command": ["varlock"],
        "startupTimeoutMs": 30000,
        "reloadTimeoutMs": 30000,
        "requireStrictEgress": true,
        "servers": {
          "example-local-mcp": {
            "env": ["FAKE_API_KEY"],
          },
          "example-remote-mcp": {
            "remote": {
              "headers": {
                "Authorization": { "env": "REMOTE_API_KEY", "prefix": "Bearer " },
                "X-Tenant": "REMOTE_TENANT",
              },
            },
          },
        },
      },
    },
  ],
  "mcp": {
    "servers": {
      "example-local-mcp": {
        "type": "local",
        "command": ["node", "./path/to/your-mcp-server.mjs"],
      },
      "example-remote-mcp": {
        "type": "remote",
        "url": "https://mcp.example.test/mcp",
        "oauth": false,
      },
    },
  },
}
