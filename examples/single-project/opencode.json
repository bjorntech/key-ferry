{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "@bjorntech/key-ferry",
      "options": {
        "enabled": true,
        "projectDirectory": ".",
        "command": ["varlock"],
        "startupTimeoutMs": 30000,
        "reloadTimeoutMs": 30000,
        "requireStrictEgress": true,
        "servers": {
          "example-local-mcp": {
            "env": ["FAKE_API_KEY"]
          },
          "example-remote-mcp": {
            "remote": {
              "headers": {
                "Authorization": {
                  "env": "REMOTE_API_KEY",
                  "prefix": "Bearer "
                },
                "X-Tenant": "REMOTE_TENANT"
              }
            }
          }
        }
      }
    }
  ],
  "mcp": {
    "servers": {
      "example-local-mcp": {
        "type": "local",
        "command": ["node", "./path/to/your-mcp-server.mjs"]
      },
      "example-remote-mcp": {
        "type": "remote",
        "url": "https://mcp.example.test/mcp",
        "oauth": false
      }
    }
  }
}
